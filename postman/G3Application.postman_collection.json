{
  "info": {
    "_postman_id": "f194a86d-ef88-4a50-a079-d662dc4030f2",
    "name": "G3Application API",
    "description": "Colección de pruebas para los endpoints públicos actuales de G3Application.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://g3application.onrender.com"
    },
    {
      "key": "page",
      "value": "0"
    },
    {
      "key": "size",
      "value": "20"
    },
    {
      "key": "userId",
      "value": "1"
    },
    {
      "key": "newUserEmail",
      "value": "postman@example.com"
    }
  ],
  "item": [
    {
      "name": "Usuarios",
      "item": [
        {
          "name": "Listar usuarios paginados",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/users?page={{page}}&size={{size}}"
          }
        },
        {
          "name": "Listar roles",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/users/roles"
          }
        },
        {
          "name": "Obtener usuario por identificador",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/users/{{userId}}"
          }
        },
        {
          "name": "Crear usuario",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"newUserEmail\", `postman-${Date.now()}@example.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"El usuario se crea\", () => {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const response = pm.response.json();",
                  "pm.collectionVariables.set(\"userId\", response.data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman\",\n  \"lastName\": \"Demo\",\n  \"email\": \"{{newUserEmail}}\",\n  \"password\": \"Password123!\",\n  \"role\": \"ROLE_INSPECTOR\"\n}"
            },
            "url": "{{baseUrl}}/api/users"
          }
        },
        {
          "name": "Actualizar usuario",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman actualizado\",\n  \"lastName\": \"Demo\",\n  \"email\": \"{{newUserEmail}}\",\n  \"role\": \"ROLE_INSPECTOR\",\n  \"enabled\": true\n}"
            },
            "url": "{{baseUrl}}/api/users/{{userId}}"
          }
        },
        {
          "name": "Restablecer contraseña",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"NuevaClave123!\"\n}"
            },
            "url": "{{baseUrl}}/api/users/{{userId}}/password"
          }
        }
      ]
    }
  ]
}
